# Required: paste your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Optional: prefix for legacy prefix commands (slash commands are primary)
COMMAND_PREFIX=!

# Optional: your test server's ID — slash commands sync here instantly.
# Without it, commands sync globally (can take up to an hour to appear).
DEV_GUILD_ID=

# Optional: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
